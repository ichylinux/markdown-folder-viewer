{
  "manifest_version": 3,
  "name": "Markdown Folder Viewer",
  "version": "1.2.0",
  "description": "Browse a local folder of Markdown files with a tree, table of contents, and basic Mermaid flowcharts.",
  "minimum_chrome_version": "86",
  "permissions": ["unlimitedStorage"],
  "action": {
    "default_title": "Markdown Folder Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "viewer.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
