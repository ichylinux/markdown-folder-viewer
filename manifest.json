{
  "manifest_version": 3,
  "name": "Markdown Folder Viewer",
  "version": "1.3.1",
  "description": "Browse a local folder of Markdown files with a tree, table of contents, and basic Mermaid flowcharts.",
  "minimum_chrome_version": "88",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_title": "Markdown Folder Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["file:///*.md", "file:///*.mdown", "file:///*.markdown"],
      "js": ["markdown.js", "render.js", "page.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["file:///*"]
    }
  ],
  "options_ui": {
    "page": "viewer.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
